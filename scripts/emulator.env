# Consumed by `npm run seed:emulator` via `node --env-file` so the command works
# on Windows and POSIX alike. No secrets live here — this is the local emulator
# address matching the emulators block in firebase.json. seed-firestore.mjs
# refuses any host that is not local, so this variable cannot point it at
# production.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
