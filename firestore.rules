rules_version = '2';

// RYP Academy portal — Firestore security rules, data contract v1.
//
// Spec: docs/portal/TEAM.md ("Data contract v1" + access matrix) and
// docs/portal/design-handoff.md §"Access control". Most portal users are
// minors: deny-by-default, and every allow below cites the matrix line it
// implements. There is no catch-all — any collection not matched here is
// unreadable and unwritable from the client, on purpose.
//
// Identity model: every request is keyed off users/{request.auth.uid}, whose
// doc carries role ('athlete'|'parent'|'coach'|'mental'|'ops'|'owner') plus
// athleteId (athlete) or householdId (parent). Role docs are provisioned by
// the Admin SDK (which bypasses rules); no client can write its own role.
//
// Assumption (flagged in the routing report): athletes/{id}.coachId and
// sessions.coachId store the coach's auth uid, so "assigned coach" is
// resource.data.coachId == request.auth.uid.
//
// NOTE for the deploy gate (PM/user only — agents never deploy): this file
// replaces the legacy dev-permissive rules, including the `/{document=**}`
// allow-any-authenticated catch-all. Legacy collections used by the 2025 app
// (userTokens, families, childAccounts, paymentRecords, purchaseRecords,
// fundingRecords, smsLogs, programs, coaches, legacy-shaped bookings) lose
// client access the moment this deploys. Sequence deployment with the
// migration off those surfaces.
//
// The "every mental read is logged" requirement cannot be expressed in rules;
// read auditing is a server-side concern (Admin SDK / telemetry), tracked as
// an open question in the routing report.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // The caller's users/{uid} doc. A missing doc makes every role check
    // error, and an errored condition denies — an authenticated stranger
    // with no role doc can read nothing.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function athleteData(athleteId) {
      return get(/databases/$(database)/documents/athletes/$(athleteId)).data;
    }

    // Sprint 20 (spec 4.4): per-athlete paid status gates booking. Absent
    // `billing` == active (every athlete provisioned before this sprint).
    function athleteBillingOk(a) {
      return !('billing' in a) || a.billing.status == 'active';
    }

    // Sprint 20 (spec 5): booking opens 07:00 America/Chicago on 2026-10-10
    // (1791633600000 - the SAME value as data/calendar.js BOOKING_OPENS_AT);
    // a paid Elite books at once (the webhook corrects packageId to the paid
    // price, so 'elite' here means paid Elite). Retire after launch (#26).
    function bookingOpenOk(a) {
      return request.time >= timestamp.value(1791633600000)
        || a.get('packageId', null) == 'elite';
    }

    // 2026-10-01 (waitlist audit, owner ruling R2): a session whose day is
    // over cannot be booked or waitlisted. `sessionDate` is the session's
    // own 'YYYY-MM-DD' (every caller has already matched it to the session
    // doc, or reads it off a booking that was matched at create), turned
    // into a timestamp the way withinOuterBookingBound does for the far end
    // of the window: split() + int() + timestamp.date(), no substring().
    // timestamp.date() is midnight UTC, and the offset chosen is + 30 HOURS:
    // midnight America/Chicago at the END of that day under CST (UTC-6, the
    // whole Nov-Mar season) and 01:00 the next morning under CDT (UTC-5).
    // Safe in both: it never closes a session's own day early, so a same-day
    // booking still reaches the rule in either zone, and the most it lets
    // through is one hour past midnight in summer, on a session the client
    // already refuses and promotion never fills on the day. 29 hours would
    // be exact under CDT but would shut the last hour of the day under CST.
    // The start TIME is not checked here - sessions.time is display text
    // ('4:00 PM') - so "has it started" stays with the client and the
    // promotion function; this is the server-side floor under both.
    function sessionDayNotOver(sessionDate) {
      let parts = sessionDate.split('-');
      return request.time
        < timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) + duration.value(30, 'h');
    }

    // 2026-10-01 (waitlist audit, "the rules do not protect capacity"): a
    // family's booking write and its seat count move in ONE commit or not
    // at all. get() is the session before this commit and getAfter() the
    // session as this commit leaves it, so "taken" is the count going up by
    // exactly one (a booking, a re-book) and "freed" is it going down by
    // exactly one (a cancel). A booking written on its own reads the same
    // count on both sides and is refused - that was the way round a full
    // session and everyone waiting on it. The counter write itself is still
    // judged by the sessions block (bookedDiffOk: one step, within
    // 0..capacity), so "taken" also means a seat was free. createBooking and
    // cancelBooking (hooks/live.js) have always written both documents in
    // one transaction, so no client change rides this. Admin SDK writers
    // (promotion, the Stripe revoke, Calendly) bypass rules and keep their
    // own counts. One extra document access per booking write (the parent +
    // grace create goes from 5 to 6 of the 10-document cap).
    function seatTakenInCommit(sessionId) {
      return getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data.booked
        == get(/databases/$(database)/documents/sessions/$(sessionId)).data.booked + 1;
    }

    function seatFreedInCommit(sessionId) {
      return getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data.booked
        == get(/databases/$(database)/documents/sessions/$(sessionId)).data.booked - 1;
    }

    // ---- users ---------------------------------------------------------
    // Matrix: "users self-read" (+ owner → all). Sprint 10 (contract v1.8,
    // "make it real"): ops now reads the full users collection too (E,
    // "Staff & Roles live" — the staff list and the enrollment approval
    // flow's staffInvites lookups both need it), and two client write paths
    // open up where none existed before:
    //   1. PROVISIONING (A, E): ops/owner may create/update ANY uid's doc —
    //      this is how enrollment approval (a client write from the ops/owner
    //      user, not the Admin SDK) creates the guardian's users doc, and how
    //      staffInvites provisioning will write a new staff account. Two
    //      privilege-escalation guards, both non-owner-only (an owner is
    //      trusted with all of this by definition):
    //        - a non-owner staff member can never touch their OWN 'role'
    //          field through this clause (self-provisioning your way from
    //          ops to owner stays impossible);
    //        - a non-owner staff member can never write role == 'owner' on
    //          ANY doc, self or otherwise (an ops account minting a NEW
    //          owner account — for a colluding party, say — would be the
    //          same escalation by a different door; the pin's "ops/owner may
    //          create/update ANY uid" grants ops write access, not the
    //          ability to grant OWNER access, which only an owner may do).
    //      In practice this clause almost always fires against a DIFFERENT
    //      uid's doc anyway, because `me()` requires the caller's OWN doc to
    //      already exist with an ops/owner role before this clause can pass
    //      at all (a not-yet-provisioned caller has no doc for `me()` to
    //      read, so the condition errors closed).
    //   2. THE ONE SELF-WRITE (G): any signed-in user may update ONLY their
    //      own notificationPrefs field on their own doc — never role,
    //      household/athlete/specialist links, or staff status. This is
    //      deliberately the sole self-writable path the users collection
    //      ever grants.
    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || me().role in ['ops', 'owner']);

      allow create: if signedIn() && me().role in ['ops', 'owner']
        && (me().role == 'owner' || request.resource.data.role != 'owner');

      allow update: if signedIn() && (
        (
          me().role in ['ops', 'owner']
          && (me().role == 'owner' || request.resource.data.role != 'owner')
          && !(
            userId == request.auth.uid
            && me().role != 'owner'
            && request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          )
        )
        || (
          // Member self-writes: notificationPrefs (v1.8), the self-service
          // phone (2026-09-16) and this device's push tokens (v2.3, Sprint
          // 15: a list of FCM tokens, at most 10) - nothing else on the doc.
          request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notificationPrefs', 'phone', 'pushTokens'])
          && (request.resource.data.get('notificationPrefs', null) is map
              || request.resource.data.get('notificationPrefs', null) == null)
          && (request.resource.data.get('phone', null) == null
              || (request.resource.data.get('phone', null) is string
                  && request.resource.data.phone.size() <= 32))
          && (request.resource.data.get('pushTokens', null) == null
              || (request.resource.data.get('pushTokens', null) is list
                  && request.resource.data.pushTokens.size() <= 10))
        )
      );
    }

    // ---- athletes ------------------------------------------------------
    // Matrix: "athlete → own records; parent → linked athletes; coach →
    // assigned athletes only (coachId match, never just role); mental →
    // academy-wide reads; ops → enrollment/completion; owner → all".
    // List queries must carry the matching equality filter (parent:
    // householdId ==, coach: coachId ==) or the query is denied wholesale.
    match /athletes/{athleteId} {
      // v1.7.1: a specialist (users.specialistId — Yannick, Phil) teaches
      // sessions any academy athlete can book, so they read athlete
      // profiles academy-wide like mental does — their roster and
      // attendance views need every booked kid's name, not just an
      // assigned subset. The medical subcollection below is deliberately
      // NOT widened (assigned coach / mental / owner only, unchanged).
      allow read: if signedIn() && (
        (me().role == 'athlete' && me().athleteId == athleteId)
        || (me().role == 'parent' && resource.data.householdId == me().householdId)
        || (me().role == 'coach' && resource.data.coachId == request.auth.uid)
        || me().role in ['mental', 'ops', 'owner']
        || me().get('specialistId', null) != null
      );

      // Sprint 10 (contract v1.8, A "Enrollment"): the FIRST client write on
      // this collection — enrollment approval creates one athletes doc per
      // enrolled kid, run by the ops/owner user approving the request (a
      // client write, not the Admin SDK, per the pin's "one batched write"
      // instruction). Kept permissive on extra fields (hasAll, not hasOnly)
      // rather than the tight hasOnly() shape locks bookings/contractLogs
      // use — this is a staff-only admin surface where the schema is
      // expected to grow (packageId, future fields), matching the existing
      // households create grant just below in this file, which has no shape
      // check at all; contractMinutes/dob still get real type checks because
      // minors' data deserves it even on a permissive surface. coachId must
      // be null at create — coach assignment stays a separate, unbuilt admin
      // action (unchanged from the original "no client writes" comment this
      // replaces).
      function athleteCreateShapeOk() {
        let d = request.resource.data;
        return d.keys().hasAll(['name', 'householdId', 'contractMinutes', 'coachId'])
          && d.name is string
          && d.householdId is string
          && (d.dob is string || d.dob == null)
          && (d.contractMinutes in [20, 45, 90, 95] || d.contractMinutes == null)
          && d.coachId == null
          // Sprint 20 (spec 2.2): handicap int 0..54 or null; loginEmail string
          // or null; billing/facilityBilling are server-written ONLY.
          && (!d.keys().hasAny(['handicap']) || d.handicap == null
              || (d.handicap is int && d.handicap >= 0 && d.handicap <= 54))
          && (!d.keys().hasAny(['loginEmail']) || d.loginEmail == null || d.loginEmail is string)
          && !d.keys().hasAny(['billing', 'facilityBilling']);
      }
      allow create: if signedIn() && me().role in ['ops', 'owner'] && athleteCreateShapeOk();

      // Sprint 10 (contract v1.8, B "Contract intake"): the athlete's own
      // user OR the household parent may set their OWN tier — the ONE
      // member-writable field on this collection, mirroring users'
      // notificationPrefs self-write just above: one field, hasOnly-locked,
      // nothing else on the profile ever becomes member-writable through it.
      // Contract-buffer Phase 2 (2026-09-30): starting a contract (no tier ->
      // a tier) also stamps contractStart, the 'yyyy-MM-dd' Chicago date the
      // contract window opens - a date string, and ONLY on that no-tier ->
      // tier start (review 2026-09-30: a member must not be able to move
      // the start later on their own and erase missed days). A tier change
      // that leaves it alone is unaffected.
      function contractMinutesUpdateOk() {
        let after = request.resource.data;
        let changed = after.diff(resource.data).affectedKeys();
        return changed.hasOnly(['contractMinutes', 'contractStart'])
          && (after.contractMinutes in [20, 45, 90, 95] || after.contractMinutes == null)
          && (!changed.hasAny(['contractStart'])
              || (resource.data.get('contractMinutes', null) == null
                  && after.contractMinutes != null
                  && after.contractStart is string
                  && after.contractStart.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
      }
      allow update: if signedIn() && contractMinutesUpdateOk() && (
        (me().role == 'athlete' && me().athleteId == athleteId)
        || (me().role == 'parent' && resource.data.householdId == me().householdId)
      );

      // Sprint 11 (contract v1.9, B "Package assignment"); NARROWED Sprint 12
      // (contract v2.0, pin A "one catalogue") — `fitnessPackageId` is
      // retired along with the fitness catalogue it pointed into, so this
      // branch drops back to the single field it started as. Still a SECOND
      // field-limited update branch beside contractMinutesUpdateOk just
      // above, same one-purpose-per-branch shape this file already uses for
      // sessions (bookedDiffOk / coachNoteUpdateOk) and bookings
      // (attendanceUpdateOk / memberBookingUpdateOk): a member's tier write
      // and a staff package write are different actors touching different
      // fields, so they get their own rule rather than one combined
      // condition that could accidentally let either caller touch the
      // other's field.
      //
      // packageId is not null-safe-read here: every athlete doc has always
      // carried it as a required string (contract v1, the athletes field
      // table) and this branch does not change that.
      function packageAssignmentUpdateOk() {
        let after = request.resource.data;
        return after.diff(resource.data).affectedKeys().hasOnly(['packageId', 'facilityAccess', 'updatedAt'])
          && after.packageId is string
          // v2.0.1 (Sprint 18): the $300 facility-access add-on may only be
          // switched ON when the signed waiver is already on the athlete
          // (copied from the enrollment consent at approval).
          && after.get('facilityAccess', false) is bool
          && (after.get('facilityAccess', false) == false
              || resource.data.get('facilityAccessConsent', null) != null);
      }
      allow update: if signedIn() && me().role in ['ops', 'owner'] && packageAssignmentUpdateOk();

      // Tester S4 (2026-09-30): a family may switch the package picked at
      // sign-up BEFORE the first payment - the household parent, or the
      // athlete's own login (the 18+ member; also a child's own login, the
      // same two callers createCheckoutSession lets pay). Only packageId
      // (+ updatedAt, the server time), only while billing.status is
      // 'pending' (never paid: active/past_due have a subscription, lapsed
      // re-subscribes at its package, absent == active), and only to a
      // monthly package - never the one-time single token
      // (data/packageChange.js holds the same list). createCheckoutSession
      // reads packageId fresh, and the webhook still corrects it to the
      // paid price, so bookingOpenOk's "'elite' means paid Elite" holds.
      function pendingPackageUpdateOk() {
        let after = request.resource.data;
        let changed = after.diff(resource.data).affectedKeys();
        return changed.hasOnly(['packageId', 'updatedAt'])
          && after.packageId in ['t-6', 't-12', 't-16', 'elite']
          && resource.data.get('billing', {}).get('status', null) == 'pending'
          && (!changed.hasAny(['updatedAt']) || after.updatedAt == request.time);
      }
      // The athlete branch is the 18+ member who created their own household
      // (createFamily mode 'athlete' sets households.createdBy to them), never
      // a child's claimed login: a child must not change what the parent is
      // about to be charged (review 2026-09-30). One extra get, on this
      // write only.
      allow update: if signedIn() && pendingPackageUpdateOk() && (
        (me().role == 'parent' && resource.data.householdId == me().householdId)
        || (me().role == 'athlete' && me().athleteId == athleteId
            && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.createdBy == request.auth.uid)
      );

      // ---- athletes/{id}/diagnostics/{captureId} -----------------------
      // Sprint 10 (contract v1.8, C "Diagnostics persistence"). Shape:
      // { athleteId, capturedBy (uid), capturedAt, updatedAt,
      //   status: 'draft'|'published', values: map, notes: string|null }.
      // Writers: the assigned coach, any specialist (me().get('specialistId',
      // null) != null — Sprint 9's null-safe pattern, reused verbatim), or
      // mental/ops/owner — the SAME set that already writes tournamentResults
      // and reads athletes academy-wide. Readers: the athlete's own user and
      // the household parent see PUBLISHED captures only (never a draft mid-
      // capture); staff (the same writer set) see everything, drafts
      // included, so a coach can resume their own in-progress capture.
      //
      // No null-resource read branch is needed here (unlike bookings/
      // contractLogs' `{athleteId}_{date}`-style deterministic-id probes):
      // captureId is an auto-id, never guessed by a client transaction —
      // saveDraft's upsert finds an existing open draft via a QUERY
      // (hooks/live.js), not a get() on a constructed id, so `resource` is
      // never null for a write this rule evaluates.
      match /diagnostics/{captureId} {
        function diagnosticStaffOk() {
          return me().role in ['mental', 'ops', 'owner']
            || (me().role == 'coach' && athleteData(athleteId).coachId == request.auth.uid)
            || me().get('specialistId', null) != null;
        }
        // Field/type checks only — caller-identity on capturedBy is handled
        // separately per create/update below, because the two operations
        // mean different things for that field (see the comment there).
        function diagnosticFieldsOk() {
          let d = request.resource.data;
          return d.keys().hasAll(['athleteId', 'capturedBy', 'capturedAt', 'updatedAt', 'status', 'values', 'notes'])
            && d.keys().hasOnly(['athleteId', 'capturedBy', 'capturedAt', 'updatedAt', 'status', 'values', 'notes'])
            && d.athleteId == athleteId
            && d.capturedBy is string
            && d.status in ['draft', 'published']
            && d.values is map
            && (d.notes is string || d.notes == null);
        }
        // On CREATE, capturedBy is who is capturing right now — the caller.
        allow create: if signedIn() && diagnosticStaffOk() && diagnosticFieldsOk()
          && request.resource.data.capturedBy == request.auth.uid
          && request.resource.data.capturedAt == request.time
          && request.resource.data.updatedAt == request.time;
        // On UPDATE, capturedBy/capturedAt stay whatever they originally
        // were — immutable history, NOT re-pinned to the current caller.
        // Deliberately does NOT require the current editor to be the
        // original capturer: any qualifying staff member (diagnosticStaffOk)
        // may continue or publish a draft someone else opened — a
        // specialist finishing a coach's in-progress capture is a real
        // workflow, not an edge case to block.
        allow update: if signedIn() && diagnosticStaffOk() && diagnosticFieldsOk()
          && request.resource.data.capturedAt == resource.data.capturedAt
          && request.resource.data.capturedBy == resource.data.capturedBy
          && request.resource.data.updatedAt == request.time;
        allow read: if signedIn() && (
          diagnosticStaffOk()
          || (me().role == 'athlete' && me().athleteId == athleteId && resource.data.status == 'published')
          || (me().role == 'parent'
              && athleteData(athleteId).householdId == me().householdId
              && resource.data.status == 'published')
        );
      }

      // ---- athletes/{id}/private/medical -------------------------------
      // Matrix + handoff 02: medical/emergency info is "visible to on-site
      // coaching staff during live sessions only. Not shown in admin views."
      // Readable ONLY by the assigned coach, mental, and owner. Deliberately
      // NOT readable by ops (admin surface) and NOT by the parent's admin
      // surface — the guardian supplied it at enrollment; the portal never
      // reflects it back through a guessable read.
      match /private/medical {
        allow read: if signedIn() && (
          me().role in ['mental', 'owner']
          || (me().role == 'coach'
              && athleteData(athleteId).coachId == request.auth.uid)
        );
        // Sprint 10 (contract v1.8 A, PM amendment): the enrollment flow is
        // now the ops/owner APPROVAL batch running on the client, so the
        // one-time write moves here — ops/owner create only, still no
        // update/delete from any client, still unreadable by ops/parents.
        allow create: if signedIn() && me().role in ['ops', 'owner'];
      }
    }

    // ---- diagnostics collection-group read ------------------------------
    // Sprint 10 (contract v1.8, C + D): the Admin "athletes with no
    // published diagnostic" list is one collectionGroup('diagnostics')
    // query rather than an N-athlete fan-out, and Firestore requires a
    // rule matched via the {path=**} recursive wildcard for a
    // collection-group query to be allowed at all (the nested
    // /athletes/{athleteId}/diagnostics/{captureId} rule above governs
    // normal per-athlete reads/writes but does NOT, by itself, license a
    // cross-athlete group query).
    //
    // Deliberately narrower than a literal reading of the pin's "coach/
    // mental/ops/owner/specialists" list: mental/ops/owner and any
    // specialist are academy-wide by the SAME precedent as the athletes
    // matrix's v1.7.1 specialist widening, so they read unconditionally.
    // A plain coach does NOT get an unconditional academy-wide grant here —
    // that would let a group query return every OTHER coach's assigned
    // athletes' diagnostics too, which is exactly the cross-family leak this
    // file's own non-negotiable ("assigned athletes only, by assignment,
    // never by role") exists to prevent. Instead a coach's read is proven
    // per-document the same way the bookings/contractLogs coach clauses
    // already do it: athleteData(resource.data.athleteId).coachId == caller,
    // which the diagnostics shape guarantees resource.data.athleteId always
    // carries. Flagged in the routing report as a deliberate tightening
    // beyond the pin's literal wording, not an oversight.
    match /{path=**}/diagnostics/{captureId} {
      allow read: if signedIn() && (
        me().role in ['mental', 'ops', 'owner']
        || me().get('specialistId', null) != null
        || (me().role == 'coach' && athleteData(resource.data.athleteId).coachId == request.auth.uid)
      );
    }

    // ---- sessions ------------------------------------------------------
    // Matrix: the schedule is not per-family data — "sessions readable by
    // any authenticated user". Writes are the seed/sync scripts' job (Admin
    // SDK) EXCEPT the one client mutation below.
    match /sessions/{sessionId} {
      allow read: if signedIn();

      // Sprint 6 pin (QA #5): booking capacity is enforced client-
      // transactionally — createBooking reads the session, requires
      // booked < capacity, writes the booking, and increments booked by 1,
      // all inside one Firestore transaction. This rule is the server-side
      // half of that guarantee: `booked` is the ONLY field a client may ever
      // touch on a session, it may only move by exactly +1 (a new booking)
      // or -1 (cancellation, and re-booking's +1 mirrors it exactly), and it
      // must stay within [0, capacity]. Every other field (capacity, coachId,
      // date, label, status, gcalEventId, type, ...) stays Admin-SDK-only —
      // `type` is never constrained to a specific list here (or anywhere
      // else in this file), so 'phil'/'mental' sessions (Sprint 9, contract
      // v1.7) need no rules change to be readable/bookable-against.
      //
      // Sprint 9 verification (routing report): the -1 branch below was
      // PRE-APPROVED at Sprint 6 for "a future cancellation flow, not built
      // yet" — that flow is cancelBooking() (hooks/live.js) as of this
      // sprint, and it needed no change here: caller scope was already any
      // signedIn() user (never role-restricted), which already covers the
      // athlete/parent callers cancellation adds.
      function bookedDiffOk() {
        let before = resource.data;
        let after = request.resource.data;
        return after.diff(before).affectedKeys().hasOnly(['booked'])
          && after.booked is int
          && (after.booked == before.booked + 1 || after.booked == before.booked - 1)
          && after.booked >= 0
          && after.booked <= before.capacity;
      }

      // 2026-10-01 (waitlist audit): WHO may move the count. It used to be
      // any signed-in account, with no booking behind the write - one bare
      // -1 on a full block made the promotion trigger fill a seat nobody
      // gave up. Now:
      //   - only a family account moves it at all (athlete or parent, the
      //     only roles the booking rules let book or cancel). A login with
      //     no users doc errors on me() and is refused; staff never move the
      //     count (Cancel session leaves it alone - sessionCancelOk below).
      //   - an ATHLETE login must change its own booking in the same commit:
      //     bookings/{athleteId}_{sessionId} ends 'confirmed' having been
      //     absent or 'cancelled' for +1, or goes 'confirmed' -> 'cancelled'
      //     for -1. A bare +1 or -1 from an athlete login is refused.
      //   - a PARENT is held to the role check only. ACCEPTED GAP, flagged
      //     in the audit hand-off: this write carries nothing but `booked`,
      //     and a parent may be booking any of several children, so the rule
      //     cannot name the booking to look up (households carry no athlete
      //     list). The other direction IS enforced for a parent too - no
      //     booking or cancel lands without its counter write
      //     (seatTakenInCommit / seatFreedInCommit on bookings). A parent's
      //     bare -1 can still wake the promotion trigger; whether a seat is
      //     really free is promotion's own check, not this file's. Closing
      //     it here needs the client to name the booking on this write, or
      //     booking to move behind a callable.
      function ownBookingMoved(athleteId) {
        let idBooking = athleteId + '_' + sessionId;
        let after = getAfter(/databases/$(database)/documents/bookings/$(idBooking)).data.status;
        return request.resource.data.booked == resource.data.booked + 1
          ? (after == 'confirmed'
              && (!exists(/databases/$(database)/documents/bookings/$(idBooking))
                  || get(/databases/$(database)/documents/bookings/$(idBooking)).data.status == 'cancelled'))
          : (after == 'cancelled'
              && get(/databases/$(database)/documents/bookings/$(idBooking)).data.status == 'confirmed');
      }

      function bookedMoverOk() {
        return me().role == 'parent'
          || (me().role == 'athlete' && ownBookingMoved(me().athleteId));
      }

      allow update: if signedIn() && bookedDiffOk() && bookedMoverOk();

      // Sprint 10 (contract v1.8, H "Session notes"): a second, independent
      // field-limited update branch — coachNote (string <=500 or null) is
      // the ONLY field this grants, entirely separate from bookedDiffOk's
      // booked-only diff above (Firestore ORs multiple `allow update`
      // blocks on the same match, same pattern the bookings match uses for
      // its own two independent update rules).
      //
      // "The assigned coach" per the pin, but sessions.coachId is null on
      // every real session (there is no session-assignment system — the
      // SAME fact that made the Sprint 6 attendance-roster rule fall back to
      // "coach reads like staff" rather than resource.data.coachId ==
      // caller, documented above on bookedDiffOk's neighbor). Checking
      // resource.data.coachId here would silently deny every real coach
      // note. This mirrors that precedent: any coach role, plus any
      // specialist (their own group/1-on-1 blocks), plus mental/ops/owner.
      function coachNoteUpdateOk() {
        let after = request.resource.data;
        return after.diff(resource.data).affectedKeys().hasOnly(['coachNote'])
          && (after.coachNote == null
              || (after.coachNote is string && after.coachNote.size() <= 500));
      }
      allow update: if signedIn() && coachNoteUpdateOk() && (
        me().role in ['coach', 'mental', 'ops', 'owner']
        || me().get('specialistId', null) != null
      );

      // Sprint 13 (contract v2.1, pin E "Cancel session"): ops/owner flips
      // a session to cancelled - the ONE field this THIRD independent
      // update branch grants, entirely separate from bookedDiffOk (this
      // rule never touches `booked` - cancelSession's client batch leaves
      // it exactly where it was; the session is gone, not emptied) and
      // coachNoteUpdateOk. Only a 'scheduled' session may be cancelled this
      // way (never re-cancel, never touch an already-cancelled doc).
      // `status` null-safe on the BEFORE side too (same generator gap
      // waitlistSessionOk documents above) - a generator-seeded session with
      // no status field is exactly as cancellable as one explicitly marked
      // 'scheduled'; only an already-cancelled session (status == 'cancelled'
      // literally) is excluded.
      function sessionCancelOk() {
        let after = request.resource.data;
        return after.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.get('status', 'scheduled') == 'scheduled'
          && after.status == 'cancelled';
      }

      allow update: if signedIn() && me().role in ['ops', 'owner'] && sessionCancelOk();
    }

    // ---- bookings ------------------------------------------------------
    // Matrix: "bookings creatable by the athlete's own user or their
    // household parent; readable by that household + assigned coach + staff".
    // Contract v2.0 (Sprint 12): ONE token pool, derived — token usage is
    // derived by querying bookings for a periodKey, never stored, so the
    // shape is locked to the contract and a booking's `periodKey` must
    // agree with its session's real date (bookingMatchesSession, below).
    match /bookings/{bookingId} {

      // Contract shape, exactly: athleteId, sessionId, date, type, periodKey,
      // status, householdId, createdBy, createdAt — nothing else.
      //
      // Sprint 9 (contract v1.7) added 'phil'/'mental' as bookable types.
      // Sprint 12 (contract v2.0, pin B) retires `pool` — a token is spent
      // by any non-cancelled booking of any session type, so there is no
      // per-type pool field left to shape-check — and adds `periodKey`: a
      // WRITE-ONCE 'YYYY-MM-DD' string naming the billing period the
      // booking's session date falls in (data/packages.js#periodFor).
      // Correctness (does this periodKey actually match the household's
      // anchor day and the session's date?) is CLIENT-DERIVED, the same
      // accepted-gap class as the token cap check itself — the rule below
      // only proves the SHAPE (a real date-like string), not the math.
      // Sprint 13 (contract v2.1, pin E "Grace tokens"): the shape grows by
      // `chargedFrom` (required - always present, ONE of the three charge-
      // order outcomes createBooking derives, hooks/live.js) and an OPTIONAL
      // `graceTokenId` (present only when chargedFrom == 'grace' - a plain
      // key-existence check, not a hasAll requirement, since most bookings
      // never carry it). hasAll still pins the nine original keys plus
      // chargedFrom as always-required; hasOnly widens by exactly one more
      // (graceTokenId) to admit it WHEN present, never anything else.
      function bookingShapeOk() {
        let d = request.resource.data;
        return d.keys().hasAll(['athleteId', 'sessionId', 'date', 'type', 'periodKey',
                                'status', 'householdId', 'createdBy', 'createdAt', 'chargedFrom'])
          && d.keys().hasOnly(['athleteId', 'sessionId', 'date', 'type', 'periodKey',
                               'status', 'householdId', 'createdBy', 'createdAt', 'chargedFrom',
                               'graceTokenId', 'attendee', 'createdVia'])
          && d.athleteId is string
          && d.sessionId is string
          && d.date is string
          && d.type in ['training', 'tournament', 'phil', 'mental']
          && d.periodKey is string
          && d.periodKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.status == 'confirmed'
          && d.chargedFrom in ['elite', 'grace', 'period']
          && (!d.keys().hasAny(['graceTokenId']) || d.chargedFrom == 'grace')
          // Absent means the athlete attends, which is every booking written
          // before the choice existed and every group booking after it.
          && (!d.keys().hasAny(['attendee'])
              || (d.attendee in ['athlete', 'parent'] && d.type == 'mental'))
          // Owner report 2026-09-30: Repeat weekly's copies say so, and the
          // booking-confirmed trigger stays quiet for them. Absent means a
          // single booking; 'repeat' is the only other value.
          && (!d.keys().hasAny(['createdVia']) || d.createdVia in ['repeat'])
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
      }

      // Sprint 13, pin E: when a booking carries a graceTokenId, its grace
      // doc must be a real, matching token that still covers this booking's
      // date - one get(), same "anchor to a real record, never trust the
      // client's claim" discipline bookingMatchesSession already applies to
      // sessionId/date/type. `expiresAt >= date` uses the same lexical
      // 'YYYY-MM-DD' string comparison the rest of this file relies on
      // (periodKey.matches() above, tournamentResults' date checks).
      function bookingGraceOk() {
        let d = request.resource.data;
        return !d.keys().hasAny(['graceTokenId'])
          || (
            d.graceTokenId is string
            && get(/databases/$(database)/documents/graceTokens/$(d.graceTokenId)).data.athleteId == d.athleteId
            && get(/databases/$(database)/documents/graceTokens/$(d.graceTokenId)).data.expiresAt >= d.date
          );
      }

      // Sprint 13, pin H: the freeze, enforced server-side - one get() of
      // the household, null-safe (membership absent == active, same
      // absent-as-default pattern athletes.packageId/households.
      // periodAnchorDay already use throughout this file).
      function bookingHouseholdOk() {
        let h = get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data;
        return !(h.get('membership', null) != null && h.membership.status in ['past_due', 'lapsed']);
      }

      // Sprint 20 (spec 4.4 + 5): the athlete doc this create already read
      // for the household check, hoisted into ONE let so the billing and
      // opens-at gates cost no extra document read (the parent + grace path
      // sits at 5 unique docs of the 10-doc cap).
      function bookingAthleteOk() {
        let a = athleteData(request.resource.data.athleteId);
        return request.resource.data.householdId == a.householdId
          && athleteBillingOk(a)
          && bookingOpenOk(a);
      }

      // The booking must reference a real session and agree with it on date
      // and type — what a booking spends is anchored to the schedule, not to
      // what the client claims.
      function bookingMatchesSession() {
        let s = get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data;
        return s.date == request.resource.data.date
          && s.type == request.resource.data.type;
      }

      // Hard OUTER bound on how far out a booking may reach (contract v2.0,
      // pin D) — a genuine server-side gate, not the client's own window
      // display: no package this catalogue can ever carry books further
      // than Elite's 45-day window, so 46 days is a fixed ceiling nothing
      // legitimate ever needs to cross, independent of any per-package
      // windowDays math (which stays client-derived, same accepted-gap
      // class as the token cap). Expressible with no substring() — `split()`
      // on the date string (already used elsewhere in this file, e.g.
      // nullReadOk's bookingId.split('_')) plus the rules language's
      // `int()` conversion and `timestamp.date()`/`duration.value()`
      // constructors, verified against the emulator (routing report).
      // Owner ruling 2026-09-30: until Nov 1 every window counts from Nov 1
      // (Elite through Dec 16), so the ceiling is the later of today and
      // 2026-11-01 plus the same 46 days - the SAME date as data/calendar.js
      // BOOKING_WINDOW_ANCHOR, one day of slack kept (Dec 17). Package-
      // agnostic, no extra read; a no-op once request.time passes Nov 1.
      // Retire with the Oct 10 gate (#26).
      // Review 2026-09-30: the anchored ceiling follows the package - Elite
      // 45 days (Dec 16), everyone else 30 (Dec 1) - each with the same one
      // day of slack, so a token family cannot book December on the server
      // before the client would let them. athleteData() is a cached get.
      function withinOuterBookingBound() {
        let parts = request.resource.data.date.split('-');
        let sessionDate = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
        let anchoredDays = athleteData(request.resource.data.athleteId).get('packageId', null) == 'elite' ? 46 : 31;
        return sessionDate <= request.time + duration.value(46, 'd')
          || sessionDate <= timestamp.date(2026, 11, 1) + duration.value(anchoredDays, 'd');
      }

      // createdBy == request.auth.uid (in shape), caller is the athlete's own
      // user or the athlete's household parent, and householdId is the
      // athlete's real household — never caller-invented.
      //
      // The doc id must be exactly `{athleteId}_{sessionId}` (contract v1.1,
      // ratified from the db lane's schema): the keyspace itself makes a
      // second booking of the same session by the same athlete an overwrite
      // attempt on an existing doc — which create rejects — rather than a
      // duplicate that inflates counts.
      //
      // 2026-10-01 (waitlist audit): two clauses joined the list, both
      // defined with the helpers at the top of this file. sessionDayNotOver
      // is the near end of the window withinOuterBookingBound closes at the
      // far end (ruling R2: no booking on a session whose day is over), and
      // seatTakenInCommit requires the session's `booked` to go up by
      // exactly one in this same commit, so a booking can no longer be
      // written past a full session's count.
      allow create: if signedIn()
        && bookingShapeOk()
        && bookingMatchesSession()
        && withinOuterBookingBound()
        && sessionDayNotOver(request.resource.data.date)
        && seatTakenInCommit(request.resource.data.sessionId)
        && bookingGraceOk()
        && bookingHouseholdOk()
        && bookingId
             == request.resource.data.athleteId + '_' + request.resource.data.sessionId
        && bookingAthleteOk()
        && (
          (me().role == 'athlete'
            && me().athleteId == request.resource.data.athleteId)
          || (me().role == 'parent'
            && me().householdId == request.resource.data.householdId)
        );

      // The booking transaction's existence check reads a doc that may not
      // exist yet — `resource` is null then, and the data-based clauses
      // below crash the whole evaluation (QA re-sweep #5: "Null value
      // error"), which broke every first-time booking. Nonexistence is
      // only revealed inside the caller's own keyspace: the doc id IS
      // `{athleteId}_{sessionId}`, so the id's athlete prefix scopes who
      // may probe. Athlete ids never contain underscores (enforced nowhere
      // better than here: a first '_' always ends the athleteId segment).
      function nullReadOk() {
        let idAthlete = bookingId.split('_')[0];
        return (me().role == 'athlete' && me().athleteId == idAthlete)
          || (me().role == 'parent'
              && exists(/databases/$(database)/documents/athletes/$(idAthlete))
              && athleteData(idAthlete).householdId == me().householdId)
          || me().role in ['coach', 'mental', 'ops', 'owner'];
      }

      // Coach reads like staff (PM ruling, post-re-sweep): real sessions
      // carry coachId null — there is no session-assignment system yet — so
      // both coach clauses (athlete-indirection, sessionCoachMatches) denied
      // every real roster list. A coach at a one-coach academy reads any
      // roster; the attendance WRITE below stays scoped to athlete.coachId.
      //
      // VERIFIED, not widened (Sprint 11, contract v1.9 pin F — family
      // Reservations): the parent clause just below,
      // `me().householdId == resource.data.householdId`, is already exactly
      // what a `bookings where householdId == :id and date >= :today`
      // list query (DATA-MODEL.md index 3) needs proved — the query's own
      // equality filter on `householdId` matches the rule's own equality
      // check field-for-field, so useHouseholdReservations' one query reads
      // every member's bookings under this SAME pre-existing grant. No rule
      // change was made for pin F; confirmed against the emulator (routing
      // report) with parent-dana's own household id and a neighbor's.
      allow read: if signedIn() && (
        resource == null
          ? nullReadOk()
          : (
            (me().role == 'athlete' && me().athleteId == resource.data.athleteId)
            || (me().role == 'parent' && me().householdId == resource.data.householdId)
            || me().role in ['coach', 'mental', 'ops', 'owner']
          )
      );

      // Sprint 6 pin (QA #6/#7): attendance IS bookings.status — coach IN ->
      // 'attended', OUT -> 'noshow', un-marking -> back to 'confirmed'. The
      // assigned coach (athlete.coachId == caller, never role alone) may
      // flip status among confirmed|attended|noshow and touch NO other
      // field. 'cancelled' is deliberately excluded from both before/after
      // here — cancellation (Sprint 9) is now built, but as its OWN rule
      // below (memberBookingUpdateOk, athlete/parent only): a coach cannot
      // cancel a booking through this attendance rule, and this rule cannot
      // be used to un-cancel one either.
      // 2026-09-10 (owner's report — the roster's inert "+ Add a reason"):
      // the same assigned-coach update may now also carry `noshowReason`, a
      // single optional free-text note (string <=200, or null to clear). It
      // rides the attendance rule rather than getting one of its own — same
      // actor, same moment, same record — and status transitions stay
      // exactly as pinned in Sprint 6.
      function attendanceUpdateOk() {
        let before = resource.data;
        let after = request.resource.data;
        return after.diff(before).affectedKeys().hasOnly(['status', 'noshowReason'])
          && before.status in ['confirmed', 'attended', 'noshow']
          && after.status in ['confirmed', 'attended', 'noshow']
          && (
            !after.keys().hasAny(['noshowReason'])
            || after.noshowReason == null
            || (after.noshowReason is string && after.noshowReason.size() <= 200)
          );
      }

      allow update: if signedIn()
        && me().role == 'coach'
        && athleteData(resource.data.athleteId).coachId == request.auth.uid
        && attendanceUpdateOk();

      // v1.7.1 (owner: specialists get "access to the back end of the
      // booked session side"): a SPECIALIST — any account whose users doc
      // carries specialistId (Yannick 'mental', Phil 'phil', written by
      // provisioning) — runs the same attendance transitions on bookings
      // for THEIR OWN session type. bookings carry `type`, so the match is
      // one field read with NO extra get(); me().get() with a null default
      // keeps every pre-v1.7.1 users doc (no specialistId field at all)
      // from erroring this condition into a global deny.
      allow update: if signedIn()
        && me().get('specialistId', null) == resource.data.type
        && attendanceUpdateOk();

      // Sprint 9 pin (contract v1.7, cancellation): the athlete's own user
      // or the household parent may cancel a CONFIRMED booking, or re-book a
      // CANCELLED one (the RE-BOOK direction — createBooking's transaction
      // treats an existing cancelled doc as the update path, same doc id per
      // the keyspace) — status flips, nothing else. This is IN ADDITION to
      // the coach attendanceUpdateOk() branch above (a second `allow update`
      // for this match block; Firestore ORs multiple allow statements for
      // the same operation) — a coach's attendance transitions and a
      // member's cancel/re-book are different actors touching the same
      // field for different reasons, so they get their own rule rather than
      // one combined condition.
      //
      // Capacity is deliberately NOT re-verified here with a second get():
      // the +1/-1 side of a cancel or re-book is a session.booked write in
      // the SAME client transaction (hooks/live.js's cancelBooking /
      // createBooking's re-book path), and that write is independently
      // guarded by the sessions match block's bookedDiffOk() above (which
      // already enforces booked staying within [0, capacity]). A get() here
      // would only re-read a doc this same transaction already reads
      // elsewhere, for no additional guarantee — capacity enforcement is the
      // transaction's job client-side and bookedDiffOk()'s job server-side,
      // not this rule's.
      //
      // The 12-hour-before cancel window (My Schedule copy: "day-of = contact
      // the academy") is a CLIENT-side gate only — an accepted server-side
      // gap, flagged in TEAM.md's Sprint 9 pins and carried into the routing
      // report. This rule allows the transition with no date check in v1.
      // Sprint 13 (contract v2.1, pin G "Cancellation reasons"): the
      // confirmed->cancelled direction now REQUIRES cancelledBy (the
      // caller's own uid) and cancelReason ('member' - the ONE value a
      // member may ever write here; 'session-cancelled'/'lapsed'/
      // 'downgrade' are staff/Admin-SDK-only reasons, never reachable
      // through this branch). The cancelled->confirmed re-book direction
      // stays exactly `hasOnly(['status'])` - re-booking never touches
      // cancelledBy/cancelReason at all (hooks/live.js's isRebook branch
      // only ever sends `{ status: 'confirmed' }`), so a malicious payload
      // cannot smuggle a cancelledBy/cancelReason rewrite through the
      // re-book direction by also flipping status.
      // 2026-09-30 (tester Mike, "cancel the entire series"): the cancel
      // direction - and ONLY it - may also carry `cancelledVia`, and the one
      // value it may hold afterwards is 'series' (hooks/cancelSeries.js; the
      // booking-cancelled trigger stays quiet for those, one on-screen
      // summary instead of a notice per week). Absent means a single cancel,
      // which also removes a marker a re-booked row still carries. Every
      // other clause is unchanged, and no other branch (re-book, attendance,
      // staff session cancel) can write the field. All it decides is whether
      // the family's own receipt is sent.
      // 2026-10-01 (waitlist audit): this supersedes the "capacity is
      // deliberately NOT re-verified here" paragraph above. Each direction
      // now proves its counter write landed in the same commit - a cancel
      // with seatFreedInCommit (booked - 1), a re-book with
      // seatTakenInCommit (booked + 1) - so a status flip can no longer be
      // sent without the seat count following it (a re-book written alone
      // was a second way past a full session). A re-book is booking, so it
      // also takes sessionDayNotOver (ruling R2); the booking's own `date`
      // was matched to its session at create and cannot be edited since.
      // Both clauses sit last on their arm: && short-circuits, so the two
      // session reads are only paid by a write every earlier clause admits.
      function memberBookingUpdateOk() {
        let before = resource.data;
        let after = request.resource.data;
        let diffKeys = after.diff(before).affectedKeys();
        return (
          (before.status == 'confirmed' && after.status == 'cancelled'
            && diffKeys.hasOnly(['status', 'cancelledBy', 'cancelReason', 'cancelledVia'])
            && after.cancelledBy == request.auth.uid
            && after.cancelReason == 'member'
            && (!after.keys().hasAny(['cancelledVia']) || after.cancelledVia == 'series')
            // Sprint 20 (spec 6.1): a Calendly-sourced booking is cancelled
            // from Calendly's email, never in-app (the webhook writes the
            // cancel). Absent source == 'portal'.
            && resource.data.get('source', null) != 'calendly'
            && seatFreedInCommit(before.sessionId))
          || (before.status == 'cancelled' && after.status == 'confirmed'
              && diffKeys.hasOnly(['status'])
              // Sprint 20 (review 2026-09-29): re-confirming is booking - the
              // same per-athlete billing and Oct 10 gates as a create, and
              // never a Calendly-sourced row. The get() runs only on this
              // arm (&& short-circuits) and is one cached document read.
              && resource.data.get('source', null) != 'calendly'
              && athleteBillingOk(athleteData(before.athleteId))
              && bookingOpenOk(athleteData(before.athleteId))
              && sessionDayNotOver(before.date)
              && seatTakenInCommit(before.sessionId))
        );
      }

      allow update: if signedIn()
        && memberBookingUpdateOk()
        && (
          (me().role == 'athlete' && me().athleteId == resource.data.athleteId)
          || (me().role == 'parent' && me().householdId == resource.data.householdId)
        );

      // Sprint 13 (contract v2.1, pin E "Cancel session"): ops/owner
      // cancelling EVERY confirmed booking on a session they are cancelling
      // from the attendance screen - a FOURTH independent update branch on
      // this match (Firestore ORs multiple `allow update` blocks; this file
      // already does exactly this for attendanceUpdateOk/the specialist
      // clause/memberBookingUpdateOk above). Scoped to confirmed->cancelled
      // ONLY - never attended/noshow/waitlisted/already-cancelled bookings,
      // which cancelSession()'s own idempotent client loop already skips
      // before it ever reaches this rule. `cancelReason` is pinned to the
      // one value this specific staff action may ever write, distinct from
      // a member's own 'member' reason above and from the Admin-SDK-only
      // 'lapsed'/'downgrade' reasons the Stripe handler writes (bypassing
      // rules entirely, so this branch never needs to admit them).
      function staffSessionCancelOk() {
        let before = resource.data;
        let after = request.resource.data;
        return before.status == 'confirmed'
          && after.status == 'cancelled'
          && after.diff(before).affectedKeys().hasOnly(['status', 'cancelledBy', 'cancelReason'])
          && after.cancelledBy == request.auth.uid
          && after.cancelReason == 'session-cancelled';
      }

      allow update: if signedIn() && me().role in ['ops', 'owner'] && staffSessionCancelOk();

      // No delete in v1.
    }

    // ---- contractLogs --------------------------------------------------
    // Matrix + contract v1.3 (docs/portal/TEAM.md, Sprint 5 pins):
    // "contractLogs writable by the athlete's own user only", doc id
    // `{athleteId}_{date}` enforced so one day is one doc — a second log of
    // the same day is an overwrite of the same id, never a duplicate.
    // Contract: { athleteId, date, minutes, contractMinutes, createdBy,
    // createdAt } — contractMinutes is a snapshot of the athlete's tier at
    // log time (nullable, mirroring athletes.contractMinutes) so history
    // survives a later tier change; it is supplied by the client and not
    // re-derived here, because a log is a record of what applied *then*, not
    // a live join against the athlete doc.
    match /contractLogs/{logId} {

      function logShapeOk() {
        let d = request.resource.data;
        return d.keys().hasAll(['athleteId', 'date', 'minutes', 'contractMinutes', 'createdBy', 'createdAt'])
          && d.keys().hasOnly(['athleteId', 'date', 'minutes', 'contractMinutes', 'createdBy', 'createdAt'])
          && d.athleteId is string
          && d.date is string
          && d.minutes is int
          && d.minutes > 0
          && d.minutes <= 720
          && (d.contractMinutes is int || d.contractMinutes == null)
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
      }

      // Writable by the athlete's own user only; the doc id must be exactly
      // athleteId + '_' + date — pins both athleteId and date to the id (a
      // caller cannot claim one day in the id while logging another in the
      // payload), and also pins them on update, mirroring the bookings
      // keyspace pattern.
      allow create, update: if signedIn()
        && me().role == 'athlete'
        && me().athleteId == request.resource.data.athleteId
        && logId == request.resource.data.athleteId + '_' + request.resource.data.date
        && logShapeOk();

      // 2026-09-10 (owner's report — the contract calendar's inert "Remove
      // entry"): an athlete may delete their OWN day's log — a mistaken
      // entry returns the day to "not logged", which the month derivation
      // renders with no other cleanup. Same identity as create, scoped by
      // the id's athleteId prefix (ids never contain '_' before the date).
      allow delete: if signedIn()
        && me().role == 'athlete'
        && me().athleteId == logId.split('_')[0];

      // Reads follow the athlete-record matrix line: own user, household
      // parent, assigned coach, mental (all), ops (completion surface),
      // owner. Parent/coach list queries must filter athleteId == for the
      // athleteData() lookup to be provable.
      //
      // The accumulate transaction reads a day's log that may not exist yet
      // — `resource` is null then, and the data-based clauses would crash
      // the evaluation (the bookings null-read lesson, same fix): the id IS
      // `{athleteId}_{date}`, so its prefix scopes who may probe
      // nonexistence.
      function logNullReadOk() {
        return me().role == 'athlete' && me().athleteId == logId.split('_')[0]
          || me().role in ['coach', 'mental', 'ops', 'owner'];
      }

      allow read: if signedIn() && (
        resource == null
          ? logNullReadOk()
          : (
            (me().role == 'athlete' && me().athleteId == resource.data.athleteId)
            || (me().role == 'parent'
                && athleteData(resource.data.athleteId).householdId == me().householdId)
            || (me().role == 'coach'
                && athleteData(resource.data.athleteId).coachId == request.auth.uid)
            || me().role in ['mental', 'ops', 'owner']
          )
      );

      // No delete: a logged day is a record. Un-logging is a product
      // decision that has not been made.
    }

    // ---- packages ------------------------------------------------------
    // Matrix: "packages read-only authenticated, writes owner-only". The
    // catalogue is not sensitive, but prices changing under a family's feet
    // is an owner-level action.
    match /packages/{packageId} {
      allow read: if signedIn();
      allow write: if signedIn() && me().role == 'owner';
    }

    // ---- households ----------------------------------------------------
    // Matrix: "households readable/writable by their own parent + ops/owner".
    // Contract: guardian contact + stripeCustomerId/stripeSubscriptionId,
    // never card data. Parents may edit their own contact fields but not the
    // Stripe linkage — those ids are written by the billing integration and
    // a parent-editable subscription pointer is a billing integrity hole.
    //
    // Sprint 12 (contract v2.0, pin B): an ATHLETE account now needs to read
    // its OWN household too — periodFor()'s anchor day lives there, and
    // every token-position derivation (schedule, booking, dashboard) reads
    // it for an athlete-linked caller exactly like a parent one. Resolved
    // via athleteData(me().athleteId).householdId rather than trusting
    // me().householdId directly — the users field table documents
    // householdId as parent-only, so an athlete doc's own copy (if any) is
    // not a contract guarantee to read from here.
    match /households/{householdId} {
      allow read: if signedIn() && (
        (me().role == 'parent' && me().householdId == householdId)
        || (me().role == 'athlete' && athleteData(me().athleteId).householdId == householdId)
        || me().role in ['ops', 'owner']
      );
      allow create, delete: if signedIn() && me().role in ['ops', 'owner'];

      // Sprint 12 (contract v2.0, pin B "Periods"): the household's billing-
      // period anchor day, ops/owner-settable in the Membership editor.
      // Value-validated (1-28, the pin's own clamp range — matches
      // data/packages.js#normalizeAnchorDay) and field-limited — the ONE
      // path `periodAnchorDay` may change through. The broad ops/owner
      // branch just below explicitly excludes this field (hasAny check) so
      // a stray out-of-range value can never slip in through the wider
      // grant instead.
      // Sprint 13 (contract v2.1, pin H): the settings branch's hasOnly
      // grows by stripeCustomerId/stripeSubscriptionId - ops/owner link a
      // household to its Stripe customer/subscription (so the webhook can
      // resolve `where stripeCustomerId == event.data.object.customer`)
      // through this SAME shaped, field-limited branch periodAnchorDay
      // already used, rather than the broad ops/owner grant just below -
      // both Stripe ids are value-checked (string or null, the "never card
      // data" policy this match's own header comment states: an id that
      // POINTS at Stripe, never anything Stripe returns about a card).
      function householdSettingsUpdateOk() {
        let after = request.resource.data;
        let diffKeys = after.diff(resource.data).affectedKeys();
        return diffKeys.hasOnly(['periodAnchorDay', 'stripeCustomerId', 'stripeSubscriptionId', 'updatedAt'])
          && (!diffKeys.hasAny(['periodAnchorDay'])
              || (after.periodAnchorDay is int && after.periodAnchorDay >= 1 && after.periodAnchorDay <= 28))
          && (!diffKeys.hasAny(['stripeCustomerId'])
              || after.stripeCustomerId is string || after.stripeCustomerId == null)
          && (!diffKeys.hasAny(['stripeSubscriptionId'])
              || after.stripeSubscriptionId is string || after.stripeSubscriptionId == null);
      }
      allow update: if signedIn() && me().role in ['ops', 'owner'] && householdSettingsUpdateOk();

      // The broad ops/owner grant (admin surfaces this file otherwise
      // leaves unshaped, e.g. guardian contact edits) now excludes all
      // three settings-branch fields - forcing periodAnchorDay AND the two
      // Stripe ids through the shaped branch above exclusively, never
      // through this wider, unchecked one.
      // Sprint 20: membership (K10 - a parent could un-freeze themselves), stripeCustomerIds, signup and createdBy are server-written; the parent branch excludes all of them.
      allow update: if signedIn() && (
        (me().role in ['ops', 'owner']
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['periodAnchorDay', 'stripeCustomerId', 'stripeSubscriptionId', 'stripeCustomerIds', 'signup', 'createdBy']))
        || (me().role == 'parent'
            && me().householdId == householdId
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['stripeCustomerId', 'stripeSubscriptionId', 'periodAnchorDay', 'membership', 'stripeCustomerIds', 'signup', 'createdBy']))
      );
    }

    // ---- tournamentResults ----------------------------------------------
    // Sprint 8 pins, contract v1.6 (docs/portal/TEAM.md, "scores, age
    // brackets, player history" — supersedes v1.5.1; prod has no result
    // docs yet and the emulator reseeds, so no migration): the
    // weekend-tournament leaderboard, now scored (strokes) instead of
    // tapped in finishing order, and split into age brackets. Standings are
    // academy-public, so unlike every other collection above the read allow
    // does not reference resource.data at all — signedIn() alone covers a
    // real doc AND a probe of one that does not exist yet, so this
    // collection needs no separate null-resource branch (the
    // bookings/contractLogs nullReadOk lesson, satisfied here for free
    // rather than worked around).
    //
    // POSITION IS NO LONGER STORED (it was in v1.5): `score` is the only
    // fact now; position, points, rank and wins are all derived at read time
    // in hooks/index.js / data/tour.js from `score` (grouped by sessionId +
    // bracket) and the TOUR_POINTS table, so tuning that table — or a coach
    // correcting a stroke count — retroactively rescores the season with no
    // rules change.
    match /tournamentResults/{resultId} {
      allow read: if signedIn();

      // Contract shape, exactly: sessionId, athleteId, name, bracket, date,
      // score, createdBy, createdAt — nothing else (no `position`, no
      // `points`, ever — both are derived at read time). `name` (contract
      // v1.5.1) and `bracket` (contract v1.6) are both write-time snapshots
      // — string or null, never absent — so the academy-public standings can
      // show every name and group by bracket without widening the athletes
      // read matrix (the full athlete doc carries dob/householdId/
      // contractMinutes; these carry name/bracket alone). `bracket` is
      // restricted to the three real bracket ids or null (an unset/unknown
      // dob) — never a caller-invented string, so an unrecognized bracket
      // can never silently form its own leaderboard group. `date` must equal
      // the payload's own sessionId's leading YYYY-MM-DD: sessions are
      // always generated as `YYYY-MM-DD-<block>` (docs/portal/TEAM.md "Data
      // contract v1"), so this ties the result to its tournament's actual
      // calendar date without a second get() — a caller cannot claim one
      // date in the payload while the id/sessionId says another. Rules
      // strings have no substring() (emulator: "Function not found error:
      // Name: [substring]", caught in the Sprint 7 integration browser
      // pass — never reintroduced here), so the prefix check is a matches()
      // pair instead: date is pinned to a literal YYYY-MM-DD first — digits
      // and hyphens only, so it is regex-inert — and sessionId must then
      // start with exactly that date. `score` is strokes for a 9-hole round:
      // an int in [18, 200], matching the client-side validation in
      // hooks/live.js's saveTournamentResults.
      function tourShapeOk() {
        let d = request.resource.data;
        return d.keys().hasAll(['sessionId', 'athleteId', 'name', 'bracket', 'date', 'score', 'createdBy', 'createdAt'])
          && d.keys().hasOnly(['sessionId', 'athleteId', 'name', 'bracket', 'date', 'score', 'createdBy', 'createdAt'])
          && d.sessionId is string
          && d.athleteId is string
          && (d.name is string || d.name == null)
          && (d.bracket in ['10U', '11-13', '14+'] || d.bracket == null)
          && d.date is string
          && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.sessionId.matches(d.date + '-.*')
          && d.score is int
          && d.score >= 18
          && d.score <= 200
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
      }

      // Doc id IS `{sessionId}_{athleteId}` (mirrors bookings/contractLogs) -
      // one result per athlete per tournament; a second entry for the same
      // athlete at the same tournament is an overwrite of the same id, never
      // a duplicate. Writable by staff who run results entry
      // (coach/mental/ops/owner) only — never the athlete or parent roles,
      // and never by role alone without also passing the shape/id checks.
      allow create, update: if signedIn()
        && me().role in ['coach', 'mental', 'ops', 'owner']
        && tourShapeOk()
        && resultId == request.resource.data.sessionId + '_' + request.resource.data.athleteId;

      // No delete in v1 (contract v1.5): corrections overwrite via update.
    }

    // ---- enrollmentRequests ---------------------------------------------
    // Sprint 10 (contract v1.8, A "Enrollment"). Doc id == the guardian's own
    // auth uid — the keyspace pins identity the same way bookings/
    // contractLogs pin theirs to an id prefix, just simpler here (whole id,
    // not a split prefix). Shape: { guardian: {name,email,phone},
    // athletes: [{name, dob, packageId, contractMinutes}], consents: {...},
    // status: 'pending'|'approved'|'declined', declineReason, createdAt,
    // updatedAt, reviewedBy, reviewedAt }.
    //
    // No null-resource read branch needed: the read rule below never
    // touches resource.data (uid-equality or role alone), so it is provable
    // whether or not the doc exists yet — same free pass tournamentResults'
    // read rule gets, documented on that match block above.
    match /enrollmentRequests/{uid} {
      function enrollmentShapeOk() {
        let d = request.resource.data;
        // guardianNotes (map | null): emergency contact + medical free text
        // the form collects; approval moves it into each athlete's
        // private/medical doc (PM integration, v1.8 amendment).
        return d.keys().hasAll(['guardian', 'athletes', 'consents', 'guardianNotes', 'status',
                                'declineReason', 'createdAt', 'updatedAt', 'reviewedBy', 'reviewedAt'])
          && d.keys().hasOnly(['guardian', 'athletes', 'consents', 'guardianNotes', 'status',
                               'declineReason', 'createdAt', 'updatedAt', 'reviewedBy', 'reviewedAt'])
          && d.guardian is map
          && d.athletes is list
          && d.consents is map
          && (d.guardianNotes is map || d.guardianNotes == null)
          && d.status in ['pending', 'approved', 'declined'];
      }

      // The submitting guardian (own uid) creates the doc once, always at
      // 'pending' — 'approved' is never a value the submitter can write, on
      // create or update, anywhere in this file.
      allow create: if signedIn() && request.auth.uid == uid && enrollmentShapeOk()
        && request.resource.data.status == 'pending'
        && request.resource.data.declineReason == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // The submitting guardian may edit their own request while it is
      // 'pending' (correcting details never flips status), OR resubmit a
      // 'declined' one — the pin's own NotProvisioned UX ("declined -> the
      // reason + 'edit and resubmit', sets status back to pending"). Both
      // cases land at the SAME single clause: the caller may never write
      // anything but 'pending' here (never 'approved' — that is ops/owner's
      // clause below, never), and declineReason/reviewedBy/reviewedAt are
      // permanently out of the guardian's diff — a resubmit's stale
      // declineReason is harmless because the screen only ever displays it
      // while status == 'declined', which resubmitting immediately leaves.
      allow update: if signedIn() && request.auth.uid == uid && enrollmentShapeOk()
        && resource.data.status in ['pending', 'declined']
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['guardian', 'athletes', 'consents', 'guardianNotes', 'status', 'updatedAt']);

      // ops/owner: status-only updates (approve/decline), the OTHER half of
      // this collection's write surface — never guardian/athletes/consents,
      // which stay the submitter's own words.
      // updatedAt rides every status flip (the approval batch stamps it) —
      // caught live at PM integration: without it here the batch's request
      // update was cleanly denied and the whole approval rolled back.
      allow update: if signedIn() && me().role in ['ops', 'owner']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'declineReason', 'reviewedBy', 'reviewedAt', 'updatedAt'])
        && request.resource.data.status in ['approved', 'declined']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;

      allow read: if signedIn() && (request.auth.uid == uid || me().role in ['ops', 'owner']);
    }

    // ---- staffInvites -----------------------------------------------------
    // Sprint 10 (contract v1.8, E "Staff & roles live"). Shape: { email,
    // role, displayName, specialistId, status: 'pending'|'provisioned',
    // createdBy, createdAt }. Owner-only create (the screen that issues
    // staff access is owner-gated, matching the existing /portal/staff
    // route); ops joins owner on read (the staff list surface). No delete —
    // an unwanted invite is left pending or provisioned, matching the
    // 'no delete in v1' posture every other write-once collection here uses.
    //
    // `email` is NOT re-validated as lowercase here: `.lower()`'s
    // availability in this ruleset is unverified without an emulator, and
    // this file's own hotfix history (substring(), Sprint 7) is the reason
    // to stay conservative about unverified string methods — lowercasing is
    // enforced client-side (hooks/live.js#createStaffInvite) instead.
    match /staffInvites/{inviteId} {
      function staffInviteShapeOk() {
        let d = request.resource.data;
        return d.keys().hasAll(['email', 'role', 'displayName', 'specialistId', 'status', 'createdBy', 'createdAt'])
          && d.keys().hasOnly(['email', 'role', 'displayName', 'specialistId', 'status', 'createdBy', 'createdAt'])
          && d.email is string
          && d.role in ['coach', 'mental', 'ops', 'owner']
          && (d.displayName is string || d.displayName == null)
          && (d.specialistId in ['phil', 'mental'] || d.specialistId == null)
          && d.status == 'pending'
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
      }
      allow create: if signedIn() && me().role == 'owner' && staffInviteShapeOk();
      allow read: if signedIn() && me().role in ['owner', 'ops'];
      allow update: if signedIn() && me().role == 'owner'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'provisioned'];
    }

    // ---- tokenPeriods -----------------------------------------------------
    // Sprint 13 (contract v2.1, pin C "Token issuance"). Shape: { athleteId,
    // householdId, periodKey, periodEnd, granted (int), source:
    // 'stripe'|'ops', eventId (Stripe event id|null), createdAt }. Doc id
    // MUST equal `{athleteId}_{periodKey}` (the bookings/contractLogs
    // keyspace discipline: one issuance record per athlete per period; a
    // second issuance for the same pair is an overwrite attempt on the same
    // id, which create-only rules reject rather than double-issuing).
    //
    // The Stripe handler writes via the Admin SDK on `invoice.paid` and
    // bypasses this file entirely. This rule governs the ONE client writer -
    // ops/owner issuing tokens by hand from the membership editor (the pin's
    // "cash and comp cases") - create-only, shape-checked, and `source`
    // pinned to 'ops' so a client can never forge a 'stripe' provenance for
    // its own write; `eventId` is therefore always null on a client write
    // (only the Admin-SDK path ever sets a real one).
    match /tokenPeriods/{periodId} {
      function tokenPeriodShapeOk() {
        let d = request.resource.data;
        return d.keys().hasAll(['athleteId', 'householdId', 'periodKey', 'periodEnd', 'granted',
                                'source', 'eventId', 'createdAt'])
          && d.keys().hasOnly(['athleteId', 'householdId', 'periodKey', 'periodEnd', 'granted',
                               'source', 'eventId', 'createdAt'])
          && d.athleteId is string
          && d.householdId is string
          && d.periodKey is string
          && d.periodKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.periodEnd is string
          && d.granted is int
          && d.granted >= 0
          && d.granted <= 40
          && d.source == 'ops'
          && d.eventId == null
          && d.createdAt == request.time;
      }

      allow create: if signedIn() && me().role in ['ops', 'owner'] && tokenPeriodShapeOk()
        && periodId == request.resource.data.athleteId + '_' + request.resource.data.periodKey
        && request.resource.data.householdId
             == athleteData(request.resource.data.athleteId).householdId;

      // Member read own (own athlete, or the parent whose household matches
      // - ONE get() of the athlete doc to prove the link, the same join
      // pattern private/medical and the bookings coach clause already use);
      // ops/owner read academy-wide, matching this file's existing
      // billing/allowance precedent (graceTokens below). This is always a
      // GET BY ID (hooks read "the doc by id for the current period and the
      // next, no query" per the pin) - the null-resource branch below is the
      // COMMON case, since most periods have no ops/Stripe issuance yet
      // (absent == the package's grant) and a get() on a non-existent doc
      // still runs this rule with `resource == null` (the bookings/
      // contractLogs null-read lesson: a bare resource.data reference here
      // would crash every probe of an unissued period).
      function tokenPeriodNullReadOk() {
        let idAthlete = periodId.split('_')[0];
        return (me().role == 'athlete' && me().athleteId == idAthlete)
          || (me().role == 'parent'
              && exists(/databases/$(database)/documents/athletes/$(idAthlete))
              && athleteData(idAthlete).householdId == me().householdId)
          || me().role in ['ops', 'owner'];
      }

      allow read: if signedIn() && (
        resource == null
          ? tokenPeriodNullReadOk()
          : (
            (me().role == 'athlete' && me().athleteId == resource.data.athleteId)
            || (me().role == 'parent'
                && athleteData(resource.data.athleteId).householdId == me().householdId)
            || me().role in ['ops', 'owner']
          )
      );

      // No client update or delete - a correction is a NEW issuance doc for
      // a different period (contract v2.1: "no client update or delete").
    }

    // ---- graceTokens --------------------------------------------------
    // Sprint 13 (contract v2.1, pin E "Grace tokens"). Shape: { athleteId,
    // householdId, expiresAt ('YYYY-MM-DD', minted + 30 days), reason:
    // 'session-cancelled'|'waitlist-expired', sourceSessionId, createdBy
    // (uid|'sweep'), createdAt }. Auto-id doc - no deterministic keyspace to
    // probe, so (unlike tokenPeriods above) there is no null-read branch to
    // write: a client never get()s a guessed graceTokens id, only queries.
    //
    // Two minting triggers exist (contract v2.1, pin E): staff cancelling a
    // session (THIS collection's one client writer, reason
    // 'session-cancelled' only) and the waitlist expiry sweep (reason
    // 'waitlist-expired', Admin SDK - bypasses this file, so the CLIENT
    // shape check below never needs to admit that reason at all).
    // Owner ruling 2026-10-01 (R1): a waitlist that closes without a spot
    // mints NOTHING any more - the entry is closed and the held token is
    // simply free again. The staff cancel above is the one minting trigger
    // left; 'waitlist-expired' is history only (tokens minted before the
    // ruling keep reading back). Nothing in this block changes: the client
    // shape already admits 'session-cancelled' alone.
    match /graceTokens/{graceId} {
      function graceShapeOk() {
        let d = request.resource.data;
        return d.keys().hasAll(['athleteId', 'householdId', 'expiresAt', 'reason',
                                'sourceSessionId', 'createdBy', 'createdAt'])
          && d.keys().hasOnly(['athleteId', 'householdId', 'expiresAt', 'reason',
                               'sourceSessionId', 'createdBy', 'createdAt'])
          && d.athleteId is string
          && d.householdId is string
          && d.expiresAt is string
          && d.expiresAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.reason == 'session-cancelled'
          && d.sourceSessionId is string
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
      }

      allow create: if signedIn() && me().role in ['ops', 'owner'] && graceShapeOk()
        && request.resource.data.householdId
             == athleteData(request.resource.data.athleteId).householdId;

      // Members read own (query athleteId == - PROVABLE for the athlete's
      // own query since the field the query itself filters on is exactly
      // the field the rule checks, the same "list queries must carry the
      // matching equality filter" precedent athletes/bookings establish
      // above; a parent's query on one child's athleteId is proved instead
      // via the get()-indirection "join" pattern this file has repeatedly
      // verified against the emulator for exactly this shape - the coach-
      // roster and diagnostics collection-group clauses elsewhere in this
      // file). ops/owner read academy-wide - the same staff-sees-everything
      // precedent bookings/athletes/diagnostics/contractLogs all already
      // grant, extended here so a support call can see a family's grace
      // token history same as every other allowance fact.
      allow read: if signedIn() && (
        (me().role == 'athlete' && me().athleteId == resource.data.athleteId)
        || (me().role == 'parent'
            && athleteData(resource.data.athleteId).householdId == me().householdId)
        || me().role in ['ops', 'owner']
      );

      // No update/delete from any client - consumption is DERIVED (a
      // non-cancelled booking whose graceTokenId == this id), never written
      // back onto the grace doc itself.
    }

    // ---- waitlist -----------------------------------------------------
    // Sprint 13 (contract v2.1, pin F "Waitlist"). Shape: { sessionId,
    // athleteId, householdId, date, periodKey, joinedAt, createdBy }. Doc id
    // `{sessionId}_{athleteId}` - one entry per athlete per session, the
    // same keyspace discipline bookings/contractLogs/tokenPeriods use.
    // 2026-10-01 (waitlist audit, owner ruling R2): create is refused for
    // a session whose day is over, for a 'mental' session, and for an
    // athlete already booked on the session; read is household-scoped.
    // Promotion and the 06:00 sweep stay Admin SDK and outside this file.
    match /waitlist/{entryId} {
      function waitlistShapeOk() {
        let d = request.resource.data;
        return d.keys().hasAll(['sessionId', 'athleteId', 'householdId', 'date', 'periodKey',
                                'joinedAt', 'createdBy'])
          && d.keys().hasOnly(['sessionId', 'athleteId', 'householdId', 'date', 'periodKey',
                               'joinedAt', 'createdBy', 'attendee'])
          && d.sessionId is string
          && d.athleteId is string
          && d.householdId is string
          && d.date is string
          && d.periodKey is string
          && d.periodKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          // Carried so promotion can write the booking the family asked for.
          && (!d.keys().hasAny(['attendee']) || d.attendee in ['athlete', 'parent'])
          && d.createdBy == request.auth.uid
          && d.joinedAt == request.time;
      }

      // The session must actually BE full and open right now - one get(),
      // the same "anchor to a real record" discipline bookingMatchesSession
      // uses for bookings; `date` is checked against the session's own too,
      // so a client cannot claim a period-affecting date the schedule does
      // not agree with.
      // `status` is null-safe: the season generator never wrote the field at
      // all until Sprint 4 (contract v1.2) added it, and the emulator's own
      // generator-seeded sessions still carry none today (db lane, Sprint 13
      // reconciliation) - only calendar-synced and hand-seeded sessions do.
      // Absent means the same thing an explicit 'scheduled' means everywhere
      // else this file reads the field (bookings' -1 branch comment already
      // documents the same generator gap) - `get('status','scheduled')`.
      // 2026-10-01 (waitlist audit): never a 'mental' session. Yannick's
      // appointments are booked through Calendly (capacity 1, booked 1 from
      // the moment the webhook writes them), so they always read "full" and
      // could be queued on, yet a Calendly cancel closes the session rather
      // than freeing a seat - the entry could never be promoted and only
      // held the family's token. `type` is read null-safe so a session with
      // no type keeps whatever answer the other clauses give it.
      function waitlistSessionOk() {
        let s = get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data;
        return s.date == request.resource.data.date
          && s.booked >= s.capacity
          && s.get('status', 'scheduled') == 'scheduled'
          && s.get('type', null) != 'mental';
      }

      // The freeze (contract v2.1, pin H), identical in shape to bookings'
      // own bookingHouseholdOk just above: one get() of the household,
      // null-safe, denying past_due/lapsed.
      function waitlistHouseholdOk() {
        let h = get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data;
        return !(h.get('membership', null) != null && h.membership.status in ['past_due', 'lapsed']);
      }

      // Sprint 20 (spec 4.4 + 5): identical to bookings' bookingAthleteOk.
      function waitlistAthleteOk() {
        let a = athleteData(request.resource.data.athleteId);
        return request.resource.data.householdId == a.householdId
          && athleteBillingOk(a)
          && bookingOpenOk(a);
      }

      // 2026-10-01 (waitlist audit): an athlete who already holds a live
      // booking on this session has nothing to wait for, so the join is
      // refused and promotion never meets an entry whose seat is already
      // taken. Only a CANCELLED booking (the keyspace keeps the doc) leaves
      // the athlete free to queue. A second ENTRY needs no clause of its
      // own: the id is {sessionId}_{athleteId}, so a repeat join is an
      // update of the existing doc and this block grants no update at all.
      function waitlistNotBookedOk() {
        let idBooking = request.resource.data.athleteId + '_' + request.resource.data.sessionId;
        return !exists(/databases/$(database)/documents/bookings/$(idBooking))
          || get(/databases/$(database)/documents/bookings/$(idBooking)).data.status == 'cancelled';
      }

      // 2026-10-01: sessionDayNotOver (ruling R2, top of this file) - no
      // joining the queue of a session whose day is over; nobody could be
      // promoted into it and the entry only held a token until the sweep.
      // The date it reads is the one waitlistSessionOk has just matched to
      // the session doc.
      allow create: if signedIn()
        && waitlistShapeOk()
        && waitlistSessionOk()
        && sessionDayNotOver(request.resource.data.date)
        && waitlistNotBookedOk()
        && waitlistHouseholdOk()
        && entryId == request.resource.data.sessionId + '_' + request.resource.data.athleteId
        && waitlistAthleteOk()
        && (
          (me().role == 'athlete' && me().athleteId == request.resource.data.athleteId)
          || (me().role == 'parent' && me().householdId == request.resource.data.householdId)
        );

      // Leave (member delete own) - the athlete's own user or the household
      // parent. Promotion and expiry deletes (contract v2.1: "admin delete -
      // promote / expire") run under the Admin SDK (the promotion trigger,
      // scripts/sweep-waitlist.mjs) and bypass this file entirely, so no
      // separate ops/owner clause is needed here for those.
      allow delete: if signedIn() && (
        (me().role == 'athlete' && me().athleteId == resource.data.athleteId)
        || (me().role == 'parent' && me().householdId == resource.data.householdId)
      );

      // READ - household-scoped, the same shape as the bookings read above
      // (2026-10-01, waitlist audit). It was `signedIn()` alone, a widening
      // made so the client could count a 1-based position from a
      // `sessionId ==` list across every family, on the reasoning that an
      // outsider resolves the ids to nothing. That reasoning was wrong:
      // tournamentResults is readable by any login and pairs athleteId with
      // the child's name, so any account - another family, or a login with
      // no role at all - could read "this named child is waiting on this
      // session". Position now comes from the waitlistPositions callable
      // (Admin SDK, returns the caller's own athletes only), so no client
      // needs another family's entry.
      //
      // List queries must carry the matching equality filter or the whole
      // query is denied (the limit this file documents on athletes and
      // bookings): an athlete login filters `athleteId ==` its own, a parent
      // filters `householdId ==` its own (alone, or beside an athleteId
      // filter - fetchBookings' shape). A `sessionId ==` list, or a parent's
      // `athleteId ==` list with no householdId, is refused for a family
      // account. coach/mental/ops/owner read all, as on bookings.
      //
      // DEPLOY ORDER (integration review 2026-10-01) - this file goes LAST:
      //   1. functions (onSessionBookedDecrease, sweepWaitlist and the new
      //      waitlistPositions);
      //   2. the frontend;
      //   3. wait for open tabs to reload - a tab left open keeps the old
      //      bundle;
      //   4. these rules, once scripts/verify-rules.mjs is green on the
      //      emulator.
      // The bundle before this change lists a parent's waitlist by
      // `athleteId ==` alone, which this rule refuses: with these rules ahead
      // of the frontend, Billing and Membership fail to load for every parent
      // and a parent's token booking fails with a permissions error.
      //
      // The null-resource branch mirrors bookings' nullReadOk: a get() of an
      // entry that does not exist is answered (not found) only inside the
      // caller's own keyspace, by the id's athlete - the LAST '_' segment
      // here, since the id is {sessionId}_{athleteId} and athlete ids never
      // contain an underscore.
      function waitlistNullReadOk() {
        let parts = entryId.split('_');
        let idAthlete = parts[parts.size() - 1];
        return (me().role == 'athlete' && me().athleteId == idAthlete)
          || (me().role == 'parent'
              && exists(/databases/$(database)/documents/athletes/$(idAthlete))
              && athleteData(idAthlete).householdId == me().householdId)
          || me().role in ['coach', 'mental', 'ops', 'owner'];
      }

      allow read: if signedIn() && (
        resource == null
          ? waitlistNullReadOk()
          : (
            (me().role == 'athlete' && me().athleteId == resource.data.athleteId)
            || (me().role == 'parent' && me().householdId == resource.data.householdId)
            || me().role in ['coach', 'mental', 'ops', 'owner']
          )
      );

      // No update ever - nothing on a waitlist entry is ever mutated; a
      // change is always a delete (leave) or a promotion (which deletes the
      // entry and creates a booking instead).
    }

    // ---- notifications ----------------------------------------------------
    // Sprint 14 (contract v2.2). The notification LEDGER - one doc per notice
    // sent, { kind, category, householdId, athleteId|null, sessionId|null,
    // bookingId|null, subjectKey, title, body, recipients[], sentAt,
    // createdAt } - written ONLY by the Cloud Functions that send it (admin
    // SDK), keyed {kind}_{subjectKey} so the id is the idempotency key. No
    // client may ever create, update or delete one, so there is no write
    // clause at all (deny-by-default, same as stripeEvents below). Members
    // read their own: a parent's query carries `householdId ==
    // me().householdId`, an athlete's `athleteId == me().athleteId` - both
    // provable because the filtered field is exactly the field the rule
    // checks (the graceTokens precedent above); ops/owner read academy-wide
    // (the staff-sees-everything precedent). Settings renders the newest
    // ten as "Recent notices".
    match /notifications/{noticeId} {
      allow read: if signedIn() && (
        (me().role == 'parent' && resource.data.householdId == me().householdId)
        || (me().role == 'athlete' && resource.data.athleteId == me().athleteId)
        || me().role in ['ops', 'owner']
      );
    }

    // ---- loginInvites -----------------------------------------------------
    // Sprint 20 (spec 2.2, 3.2). Doc id == the child's login email, lower-
    // cased; written ONLY by createFamily/addAthletes/claimInvite (Admin
    // SDK). Read by the email's owner once VERIFIED (no enumeration by an
    // unverified account), by the household's parent, or ops/owner. The
    // token map is read null-safe: an emulator custom-token user has no
    // email claim at all. No client write clause: deny-by-default.
    match /loginInvites/{email} {
      allow read: if signedIn() && (
        (request.auth.token.get('email_verified', false) == true
          && request.auth.token.get('email', '').lower() == email)
        || (me().role == 'parent' && resource.data.householdId == me().householdId)
        || me().role in ['ops', 'owner']
      );
    }

    // ---- calendlyEvents --------------------------------------------------
    // Sprint 20 (spec 6.2, 7): the Calendly webhook's idempotency ledger,
    // Admin-SDK-written; ops/owner read it for the sign-ups report's flags.
    match /calendlyEvents/{eventId} {
      allow read: if signedIn() && me().role in ['ops', 'owner'];
    }

    // ---- stripeEvents -----------------------------------------------------
    // Sprint 13 (contract v2.1, pin H). The Stripe webhook handler's
    // idempotency ledger - { type, customer, householdId|null, receivedAt,
    // outcome } - written by the Admin SDK inside the SAME transaction as
    // the event's effect (invoice.paid, payment_failed, etc.). No allow
    // statement of any kind: Admin SDK writers bypass rules entirely, and
    // this file has no catch-all, so deny-by-default already covers every
    // client request here. This block exists purely to document that
    // explicitly - "deny all clients" - rather than leave the collection
    // unmentioned next to every other one this file names.
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // No catch-all. Everything not matched above is denied.
  }
}
