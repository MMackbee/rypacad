rules_version = '2';

// RYP Academy portal — Firestore security rules, data contract v1.
//
// Spec: docs/portal/TEAM.md ("Data contract v1" + access matrix) and
// docs/portal/design-handoff.md §"Access control". Most portal users are
// minors: deny-by-default, and every allow below cites the matrix line it
// implements. There is no catch-all — any collection not matched here is
// unreadable and unwritable from the client, on purpose.
//
// Identity model: every request is keyed off users/{request.auth.uid}, whose
// doc carries role ('athlete'|'parent'|'coach'|'mental'|'ops'|'owner') plus
// athleteId (athlete) or householdId (parent). Role docs are provisioned by
// the Admin SDK (which bypasses rules); no client can write its own role.
//
// Assumption (flagged in the routing report): athletes/{id}.coachId and
// sessions.coachId store the coach's auth uid, so "assigned coach" is
// resource.data.coachId == request.auth.uid.
//
// NOTE for the deploy gate (PM/user only — agents never deploy): this file
// replaces the legacy dev-permissive rules, including the `/{document=**}`
// allow-any-authenticated catch-all. Legacy collections used by the 2025 app
// (userTokens, families, childAccounts, paymentRecords, purchaseRecords,
// fundingRecords, smsLogs, programs, coaches, legacy-shaped bookings) lose
// client access the moment this deploys. Sequence deployment with the
// migration off those surfaces.
//
// The "every mental read is logged" requirement cannot be expressed in rules;
// read auditing is a server-side concern (Admin SDK / telemetry), tracked as
// an open question in the routing report.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // The caller's users/{uid} doc. A missing doc makes every role check
    // error, and an errored condition denies — an authenticated stranger
    // with no role doc can read nothing.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function athleteData(athleteId) {
      return get(/databases/$(database)/documents/athletes/$(athleteId)).data;
    }

    // ---- users ---------------------------------------------------------
    // Matrix: "users self-read" (+ owner → all). No client writes: roles and
    // household/athlete links are provisioned server-side, because a
    // self-writable role field is a privilege-escalation path.
    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || me().role == 'owner');
      // No write rule: deny-by-default stands.
    }

    // ---- athletes ------------------------------------------------------
    // Matrix: "athlete → own records; parent → linked athletes; coach →
    // assigned athletes only (coachId match, never just role); mental →
    // academy-wide reads; ops → enrollment/completion; owner → all".
    // List queries must carry the matching equality filter (parent:
    // householdId ==, coach: coachId ==) or the query is denied wholesale.
    match /athletes/{athleteId} {
      allow read: if signedIn() && (
        (me().role == 'athlete' && me().athleteId == athleteId)
        || (me().role == 'parent' && resource.data.householdId == me().householdId)
        || (me().role == 'coach' && resource.data.coachId == request.auth.uid)
        || me().role in ['mental', 'ops', 'owner']
      );
      // No client writes in v1: enrollment and coach assignment are
      // server-side (Admin SDK) operations.

      // ---- athletes/{id}/private/medical -------------------------------
      // Matrix + handoff 02: medical/emergency info is "visible to on-site
      // coaching staff during live sessions only. Not shown in admin views."
      // Readable ONLY by the assigned coach, mental, and owner. Deliberately
      // NOT readable by ops (admin surface) and NOT by the parent's admin
      // surface — the guardian supplied it at enrollment; the portal never
      // reflects it back through a guessable read.
      match /private/medical {
        allow read: if signedIn() && (
          me().role in ['mental', 'owner']
          || (me().role == 'coach'
              && athleteData(athleteId).coachId == request.auth.uid)
        );
        // No client writes: medical info is written once by the enrollment
        // flow, server-side.
      }
    }

    // ---- sessions ------------------------------------------------------
    // Matrix: the schedule is not per-family data — "sessions readable by
    // any authenticated user". Writes are the seed/sync scripts' job (Admin
    // SDK) EXCEPT the one client mutation below.
    match /sessions/{sessionId} {
      allow read: if signedIn();

      // Sprint 6 pin (QA #5): booking capacity is enforced client-
      // transactionally — createBooking reads the session, requires
      // booked < capacity, writes the booking, and increments booked by 1,
      // all inside one Firestore transaction. This rule is the server-side
      // half of that guarantee: `booked` is the ONLY field a client may ever
      // touch on a session, it may only move by exactly +1 (a new booking)
      // or -1 (a future cancellation flow, not built yet — the range is
      // pre-approved so that flow needs no second rules change), and it must
      // stay within [0, capacity]. Every other field (capacity, coachId,
      // date, label, status, gcalEventId, ...) stays Admin-SDK-only.
      function bookedDiffOk() {
        let before = resource.data;
        let after = request.resource.data;
        return after.diff(before).affectedKeys().hasOnly(['booked'])
          && after.booked is int
          && (after.booked == before.booked + 1 || after.booked == before.booked - 1)
          && after.booked >= 0
          && after.booked <= before.capacity;
      }

      allow update: if signedIn() && bookedDiffOk();
    }

    // ---- bookings ------------------------------------------------------
    // Matrix: "bookings creatable by the athlete's own user or their
    // household parent; readable by that household + assigned coach + staff".
    // A booking write records which pool it spends (two-pool allowance is
    // routing truth), and allowance usage is derived by querying bookings —
    // so the shape is locked to the contract and the pool must match the
    // session's type: a tournament block can never be recorded as spending
    // the training pool.
    match /bookings/{bookingId} {

      // Contract shape, exactly: athleteId, sessionId, date, type, pool,
      // status, householdId, createdBy, createdAt — nothing else.
      function bookingShapeOk() {
        let d = request.resource.data;
        return d.keys().hasAll(['athleteId', 'sessionId', 'date', 'type', 'pool',
                                'status', 'householdId', 'createdBy', 'createdAt'])
          && d.keys().hasOnly(['athleteId', 'sessionId', 'date', 'type', 'pool',
                               'status', 'householdId', 'createdBy', 'createdAt'])
          && d.athleteId is string
          && d.sessionId is string
          && d.date is string
          && d.type in ['training', 'tournament']
          && d.pool == (d.type == 'tournament' ? 'tournaments' : 'training')
          && d.status == 'confirmed'
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
      }

      // The booking must reference a real session and agree with it on date
      // and type — the pool spent is anchored to the schedule, not to what
      // the client claims.
      function bookingMatchesSession() {
        let s = get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data;
        return s.date == request.resource.data.date
          && s.type == request.resource.data.type;
      }

      // createdBy == request.auth.uid (in shape), caller is the athlete's own
      // user or the athlete's household parent, and householdId is the
      // athlete's real household — never caller-invented.
      //
      // The doc id must be exactly `{athleteId}_{sessionId}` (contract v1.1,
      // ratified from the db lane's schema): the keyspace itself makes a
      // second booking of the same session by the same athlete an overwrite
      // attempt on an existing doc — which create rejects — rather than a
      // duplicate that inflates counts.
      allow create: if signedIn()
        && bookingShapeOk()
        && bookingMatchesSession()
        && bookingId
             == request.resource.data.athleteId + '_' + request.resource.data.sessionId
        && request.resource.data.householdId
             == athleteData(request.resource.data.athleteId).householdId
        && (
          (me().role == 'athlete'
            && me().athleteId == request.resource.data.athleteId)
          || (me().role == 'parent'
            && me().householdId == request.resource.data.householdId)
        );

      // Readable by that household (athlete's own user + household parent),
      // the assigned coach, and staff (mental / ops / owner). Coach access is
      // by assignment on the athlete doc, never by role alone.
      //
      // Sprint 6 pin (QA #7 — "narrowest read grant, flagged prominently"):
      // useSessionAttendance's roster query is `bookings where sessionId ==
      // AND status in [...]` — a LIST query. The athleteId-based coach clause
      // above only ever worked for single-document reads; verified against
      // the emulator that a get()-indirection rule keyed off a field the
      // query does NOT filter on (athleteId here) makes the ENTIRE list
      // request fail with an evaluation error, not a silently-filtered
      // subset — this is NOT "coach sees nothing," it is "coach sees
      // PERMISSION_DENIED," which is why this second, narrower clause exists.
      // It is provable because sessionId IS the query's own equality filter:
      // a coach may list bookings for a session THEY are assigned to run
      // (sessions.coachId), regardless of which coach each individual
      // athlete in that block is assigned to elsewhere. This is intentionally
      // a different, wider boundary than "assigned athlete only" for this one
      // read path — flagged here and in the routing report for PM review;
      // the attendance WRITE below stays scoped to athlete.coachId exactly as
      // pinned, so a coach can see a shared block's full roster but can only
      // mark the athletes actually assigned to them.
      function sessionCoachMatches() {
        return get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.coachId
          == request.auth.uid;
      }

      allow read: if signedIn() && (
        (me().role == 'athlete' && me().athleteId == resource.data.athleteId)
        || (me().role == 'parent' && me().householdId == resource.data.householdId)
        || (me().role == 'coach'
            && athleteData(resource.data.athleteId).coachId == request.auth.uid)
        || (me().role == 'coach' && sessionCoachMatches())
        || me().role in ['mental', 'ops', 'owner']
      );

      // Sprint 6 pin (QA #6/#7): attendance IS bookings.status — coach IN ->
      // 'attended', OUT -> 'noshow', un-marking -> back to 'confirmed'. The
      // assigned coach (athlete.coachId == caller, never role alone) may
      // flip status among confirmed|attended|noshow and touch NO other
      // field. Cancellation (status: 'cancelled') is still a flow that has
      // not been built — before/after both exclude it on purpose, so this
      // rule cannot be used to cancel or un-cancel a booking. Open question
      // (cancellation policy, roster close-out) carried over in the report.
      function attendanceUpdateOk() {
        let before = resource.data;
        let after = request.resource.data;
        return after.diff(before).affectedKeys().hasOnly(['status'])
          && before.status in ['confirmed', 'attended', 'noshow']
          && after.status in ['confirmed', 'attended', 'noshow'];
      }

      allow update: if signedIn()
        && me().role == 'coach'
        && athleteData(resource.data.athleteId).coachId == request.auth.uid
        && attendanceUpdateOk();

      // No delete in v1.
    }

    // ---- contractLogs --------------------------------------------------
    // Matrix + contract v1.3 (docs/portal/TEAM.md, Sprint 5 pins):
    // "contractLogs writable by the athlete's own user only", doc id
    // `{athleteId}_{date}` enforced so one day is one doc — a second log of
    // the same day is an overwrite of the same id, never a duplicate.
    // Contract: { athleteId, date, minutes, contractMinutes, createdBy,
    // createdAt } — contractMinutes is a snapshot of the athlete's tier at
    // log time (nullable, mirroring athletes.contractMinutes) so history
    // survives a later tier change; it is supplied by the client and not
    // re-derived here, because a log is a record of what applied *then*, not
    // a live join against the athlete doc.
    match /contractLogs/{logId} {

      function logShapeOk() {
        let d = request.resource.data;
        return d.keys().hasAll(['athleteId', 'date', 'minutes', 'contractMinutes', 'createdBy', 'createdAt'])
          && d.keys().hasOnly(['athleteId', 'date', 'minutes', 'contractMinutes', 'createdBy', 'createdAt'])
          && d.athleteId is string
          && d.date is string
          && d.minutes is int
          && d.minutes > 0
          && d.minutes <= 720
          && (d.contractMinutes is int || d.contractMinutes == null)
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
      }

      // Writable by the athlete's own user only; the doc id must be exactly
      // athleteId + '_' + date — pins both athleteId and date to the id (a
      // caller cannot claim one day in the id while logging another in the
      // payload), and also pins them on update, mirroring the bookings
      // keyspace pattern.
      allow create, update: if signedIn()
        && me().role == 'athlete'
        && me().athleteId == request.resource.data.athleteId
        && logId == request.resource.data.athleteId + '_' + request.resource.data.date
        && logShapeOk();

      // Reads follow the athlete-record matrix line: own user, household
      // parent, assigned coach, mental (all), ops (completion surface),
      // owner. Parent/coach list queries must filter athleteId == for the
      // athleteData() lookup to be provable.
      allow read: if signedIn() && (
        (me().role == 'athlete' && me().athleteId == resource.data.athleteId)
        || (me().role == 'parent'
            && athleteData(resource.data.athleteId).householdId == me().householdId)
        || (me().role == 'coach'
            && athleteData(resource.data.athleteId).coachId == request.auth.uid)
        || me().role in ['mental', 'ops', 'owner']
      );

      // No delete: a logged day is a record. Un-logging is a product
      // decision that has not been made.
    }

    // ---- packages ------------------------------------------------------
    // Matrix: "packages read-only authenticated, writes owner-only". The
    // catalogue is not sensitive, but prices changing under a family's feet
    // is an owner-level action.
    match /packages/{packageId} {
      allow read: if signedIn();
      allow write: if signedIn() && me().role == 'owner';
    }

    // ---- households ----------------------------------------------------
    // Matrix: "households readable/writable by their own parent + ops/owner".
    // Contract: guardian contact + stripeCustomerId/stripeSubscriptionId,
    // never card data. Parents may edit their own contact fields but not the
    // Stripe linkage — those ids are written by the billing integration and
    // a parent-editable subscription pointer is a billing integrity hole.
    match /households/{householdId} {
      allow read: if signedIn() && (
        (me().role == 'parent' && me().householdId == householdId)
        || me().role in ['ops', 'owner']
      );
      allow create, delete: if signedIn() && me().role in ['ops', 'owner'];
      allow update: if signedIn() && (
        me().role in ['ops', 'owner']
        || (me().role == 'parent'
            && me().householdId == householdId
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['stripeCustomerId', 'stripeSubscriptionId']))
      );
    }

    // No catch-all. Everything not matched above is denied.
  }
}
