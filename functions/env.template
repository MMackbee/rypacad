# Cloud Functions environment. Copy to functions/.env and fill in.
# functions/.env IS GITIGNORED (repo .gitignore, "Env files") and must stay
# that way - no secret ever enters a tracked file. For deploys, these are set
# as function environment variables / secrets by the owner, not from here.

# Stripe --------------------------------------------------------------------
# STRIPE_WEBHOOK_SECRET is REQUIRED by stripeWebhook (contract v2.1, pin H):
# the handler refuses every request with 500 when it is unset, because an
# unverified webhook is an open write endpoint. Get it from the Stripe
# dashboard endpoint (Developers -> Webhooks -> the rypacad endpoint ->
# "Signing secret"), or from `stripe listen` when testing locally.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# STRIPE_SECRET_KEY is NOT used by the webhook (signature verification needs
# no API key). It is what scripts/export-memberships.mjs reads, read-only.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Twilio --------------------------------------------------------------------
# TWILIO_AUTH_TOKEN doubles as handleSMSResponse's shared secret: the webhook
# rejects any request without a matching X-Twilio-Signature.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Courier -------------------------------------------------------------------
# Absent COURIER_AUTH_TOKEN, every notification is logged and skipped - the
# triggers still complete, they just say nothing. The EVENT ids are optional
# Courier Studio templates; with none set the helpers send ad-hoc content.
COURIER_AUTH_TOKEN=your_courier_auth_token_here
# Waitlist promotion (portal/promotion.js). Falls back to
# COURIER_EVENT_WAITLIST_OPEN, then to ad-hoc content.
COURIER_EVENT_WAITLIST_PROMOTED=
COURIER_EVENT_WAITLIST_OPEN=
# Parent booked a session for their child (onBookingCreateNotifyChild).
COURIER_EVENT_CHILD_BOOKED=

# Firebase ------------------------------------------------------------------
# Auto-configured in a deployed function; set only for local scripts.
FIREBASE_PROJECT_ID=rypacad

# Optional: Sentry for error tracking
SENTRY_DSN=your_sentry_dsn_here

# Optional: Slack webhook for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
